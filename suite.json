      "wm_class": "snakes-n64-decompiler-list",
      "command": "",
      "categories": "Game;Emulator;",
      "accepts_files": false,
      "legacy_desktop": []
    },
    {
      "id": "soundpad",
      "name": "Snake's SoundPad",
      "tagline": "Soundboard",
      "description": "Play clips through a virtual mic into Discord and games.",
      "folder": "tools/Snake's SoundPad",
