{
  "version": "1.0.0",
  "tools": [
    {
      "id": "code",
      "name": "Snake's Code",
      "tagline": "Code editor",
      "description": "A full code editor with Monaco, a terminal, git and search.",
      "folder": "tools/Snake's Code",
      "kind": "electron",
      "platforms": [
        "linux",
        "windows",
        "macos"
      ],
      "needs": [
        "Node.js 20+ (npm)"
      ],
      "assets": {},
      "wm_class": "snakes-code",
      "command": "snakes-code",
      "categories": "Development;TextEditor;IDE;",
      "accepts_files": true,
      "legacy_desktop": [
        "snakes-code.desktop"
      ]
    },
    {
      "id": "compressor",
      "name": "Snake's Compressor",
      "tagline": "Lossless archiver",
      "description": "Pack big files and folders into checksummed .snake archives.",
      "folder": "tools/Snake's Compressor",
      "kind": "cargo",
      "binary": "snake-gui",
      "extra_binaries": [
        "snake"
      ],
      "cargo_args": [],
      "platforms": [
        "linux",
        "windows",
        "macos"
      ],
      "needs": [
        "Rust (cargo)"
      ],
      "egui_theme": "src/gui/snake_theme.rs",
      "assets": {
        "dir": "assets",
        "rgba64": true
      },
      "wm_class": "snakes-compressor",
      "command": "snake",
      "categories": "Utility;Archiving;Compression;",
      "accepts_files": false,
      "legacy_desktop": []
    },
    {
      "id": "converter",
      "name": "Snake's Converter",
      "tagline": "File converter",
      "description": "Audio, video, images, documents, spreadsheets and PDFs.",
      "folder": "tools/Snake's Converter",
      "kind": "python",
      "module": "snakes_converter",
      "pip": [
        "."
      ],
      "platforms": [
        "linux",
        "windows",
        "macos"
      ],
      "needs": [
        "Python 3.10+"
      ],
      "qt_theme": "snakes_converter/gui/snake_theme.py",
      "assets": {
        "dir": "snakes_converter/assets"
      },
      "wm_class": "snakes-converter",
      "command": "snakes-converter",
      "categories": "Utility;",
      "accepts_files": false,
      "legacy_desktop": []
    },
    {
