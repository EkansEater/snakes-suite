{
  "name": "snakes-terminal",
  "version": "1.0.0",
  "description": "Snake's Terminal: tabs, split panes, profiles and easy SSH between your devices",
  "main": "src/main/main.js",
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "start": "node build.mjs && electron .",
    "dev": "node build.mjs && electron . --dev",
    "lint": "eslint src build.mjs",
    "rebuild": "electron-rebuild -f -w node-pty",
    "postinstall": "electron-rebuild -f -w node-pty"
  },
  "type": "commonjs",
  "dependencies": {
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@xterm/addon-clipboard": "^0.2.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-image": "^0.9.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "multicast-dns": "^7.2.5",
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.1",
    "electron": "^44.7.2",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "globals": "^17.13.0"
  },
  "productName": "Snake's Terminal",
  "desktopName": "snakes-terminal.desktop",
  "author": "Snake",
  "allowScripts": {
    "esbuild": true,
    "node-pty": true,
    "electron": true
  },
  "bin": {
    "snakes-terminal": "bin/snakes-terminal"
  },
  "build": {
    "appId": "com.snake.suite.terminal",
    "productName": "Snake's Terminal",
    "directories": {
      "output": "release"
    },
    "files": [
      "package.json",
      "src/main/**",
      "dist/**",
      "assets/**"
    ],
    "icon": "assets/icon.png",
    "linux": {
      "target": "dir",
      "executableName": "snakes-terminal",
      "category": "System;TerminalEmulator"
    },
    "win": {
      "target": "dir"
    },
    "mac": {
      "target": "dir",
      "category": "public.app-category.developer-tools",
      "identity": "-"
    },
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "loadBrowserProcessSpecificV8Snapshot": false
    }
  }
}
